        android:fillColor="#FF0F172A"
        android:strokeColor="#FF60A5FA"
        android:strokeWidth="1.5" />

    <path
        android:pathData="M156,260 L164,260 L162,380 L158,380 Z"
        android:fillColor="#FF2563EB" />

    <!-- Glowing Tablet Held by Founder -->
    <path
        android:pathData="M230,380 L440,330 L450,560 L240,610 Z"
        android:fillColor="#2200D8FF"
        android:strokeColor="#FF00E5FF"
        android:strokeWidth="3" />

