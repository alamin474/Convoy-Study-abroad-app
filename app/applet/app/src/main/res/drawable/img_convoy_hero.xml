    android:width="1280dp"
    android:height="720dp"
    android:viewportWidth="1280"
    android:viewportHeight="720">

    <!-- Background dark tech gradient -->
    <path
        android:pathData="M0,0h1280v720h-1280z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="1280"
                android:endY="720"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF0F172A" />
                <item android:offset="0.5" android:color="#FF0B1329" />
                <item android:offset="1.0" android:color="#FF070C1B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing tech grid lines -->
    <path
        android:pathData="M20,20 h1240 v680 h-1240 z"
        android:strokeColor="#1E3A8A"
        android:strokeWidth="1.5" />

    <path
        android:pathData="M40,40 h1200 v640 h-1200 z"
        android:strokeColor="#3B82F6"
        android:strokeWidth="0.8" />

    <!-- Founder figure placeholder outline (Suit & Tie figure) -->
    <!-- Head & Shoulders -->
