        android:pathData="M660,320 h220 v260 h-220 z"
        android:fillColor="#FF1E293B"
        android:strokeColor="#FF3B82F6"
        android:strokeWidth="2" />

    <!-- University Card 2: MIT -->
    <path
        android:pathData="M920,320 h220 v260 h-220 z"
        android:fillColor="#FF1E293B"
        android:strokeColor="#FF3B82F6"
        android:strokeWidth="2" />

    <!-- Action Buttons at bottom -->
    <path
        android:pathData="M970,610 h170 v50 h-170 z"
