        android:fillColor="#1F1E293B"
        android:strokeColor="#FF60A5FA"
        android:strokeWidth="1" />

    <!-- Application Tracking -->
    <path
        android:pathData="M540,540 h170 v45 h-170 z"
        android:fillColor="#1F1E293B"
        android:strokeColor="#FF38BDF8"
        android:strokeWidth="1" />

    <!-- University Card 1: Oxford -->
